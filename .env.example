# Community Admin environment — sanitized example (tracked).
# For local use: cp .env.example .env.local (ignored by Git).
# For the container (README.md, Container): cp .env.example .env.production,
# and write the values without quotes.
# Do not copy Amer CRM's API URL, cookie names, or secrets into this app.
#
# Users sign in on Ability Portal, which stores the portal backend's sign-in
# answer in the ability_portal_session cookie; this app reads it on every
# page and opens only when the sign-in lists community-admin. Mobile resident
# and guest access is separate and not configured here.

# Ability Portal, where signed-out users are sent to sign in. Server-only,
# read at runtime; without it, signed-out pages show "sign-in isn't
# available", never the product.
PORTAL_URL=http://localhost:9992

# The Community Admin API addresses this app accepts, comma-separated. The
# value below is the development server (named api-prd, but it is the
# development server). Each client's address comes with its sign-in
# (`platforms[community-admin].apiUrl`) and is used only when listed here
# (`readApiBaseUrl` in src/lib/session.ts). Under `npm run dev` the browser
# calls this app's own /api/dev-proxy/admin/<n> instead, which forwards to the
# n-th address here, so local runs need no CORS entry
# (src/lib/devApiProxy.ts; restart `npm run dev` after changing this list).
# https:, or http: for loopback and private-network dev hosts. Server-only,
# read at runtime.
API_ALLOWED_URLS=https://api-prd.ability-tech.com/admin
